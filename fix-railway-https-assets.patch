 .env.example                            |  3 +++
 CLAUDE.md                               |  2 +-
 app/Providers/AppServiceProvider.php    |  7 ++++++
 bootstrap/app.php                       | 10 ++++++++
 docs/ARCHITECTURE.md                    | 10 ++++++++
 docs/SMOKE-TEST.md                      |  8 ++++++
 tests/Feature/Shell/HttpsAssetsTest.php | 33 +++++++++++++++++++++++++
 7 files changed, 72 insertions(+), 1 deletion(-)
 create mode 100644 tests/Feature/Shell/HttpsAssetsTest.php

diff --git a/.env.example b/.env.example
index 0fafaf6..ecddbdb 100644
--- a/.env.example
+++ b/.env.example
@@ -95,6 +95,9 @@ LOG_CHANNEL=stderr
 # them as separate Railway services.
 RUN_WORKERS=1
 
+# Production (Railway): APP_ENV=production and APP_URL=https://<your-domain>. Links are forced to https
+# and the proxy's X-Forwarded-Proto is trusted, so styles and scripts load on the https page.
+
 # Where a school's own custom domain must point (CNAME). On Railway, set this
 # to the service hostname, e.g. xxxx.up.railway.app. Defaults to APP_DOMAIN.
 CUSTOM_DOMAIN_TARGET=
