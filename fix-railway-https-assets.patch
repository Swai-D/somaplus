+
+## Production on Railway (HTTPS styling)
+
+1. Open the deployed address in a browser: the sign-in page shows the Somaplus styling (Bootstrap look, logo), not plain unstyled HTML.
+2. In the browser's developer tools, Network tab: `/assets/css/style.css` and `/assets/css/somaplus.css` load from `https://` with status 200, and the Console shows no "Mixed Content" warnings.
+3. View the page source: every `href`/`src` that starts with the site address starts with `https://`.
+4. Request a password reset: the emailed link starts with `https://`.
+
diff --git a/tests/Feature/Shell/HttpsAssetsTest.php b/tests/Feature/Shell/HttpsAssetsTest.php
new file mode 100644
index 0000000..37d6809
--- /dev/null
+++ b/tests/Feature/Shell/HttpsAssetsTest.php
@@ -0,0 +1,33 @@
+<?php
+
+use App\Models\Tenant;
+
+beforeEach(function () {
+    useTestHosts();
+});
+
+it('builds https asset links behind a proxy that ends TLS', function () {
+    $this->get('http://somaplus.test/login', ['X-Forwarded-Proto' => 'https'])
+        ->assertOk()
+        ->assertSee('https://somaplus.test/assets/css/style.css', false)
+        ->assertSee('https://somaplus.test/assets/css/somaplus.css', false)
+        ->assertDontSee('http://somaplus.test/assets/', false);
+});
+
+it('keeps http links when no proxy says the request was https', function () {
+    $this->get('http://somaplus.test/login')
+        ->assertOk()
+        ->assertSee('http://somaplus.test/assets/css/style.css', false);
+});
+
+it('does not let X-Forwarded-Host choose the school', function () {
+    Tenant::factory()->create(['slug' => 'acme', 'name' => 'Acme Secondary']);
+
+    $this->get('http://somaplus.test/login', [
+        'X-Forwarded-Proto' => 'https',
+        'X-Forwarded-Host' => 'acme.somaplus.test',
+    ])
+        ->assertOk()
+        ->assertSee(__('auth.subtitle_platform'))
+        ->assertDontSee('Acme Secondary');
+});
