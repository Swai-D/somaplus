APP_NAME="Somaplus"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local PostgreSQL from docker-compose.yml (tests use SQLite in memory, see phpunit.xml)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=somaplus
DB_USERNAME=somaplus
DB_PASSWORD=somaplus

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local Mailpit from docker-compose.yml (web UI on http://localhost:8025)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@somaplus.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Tenancy: hosts without a school (super-admin area) and the domain whose
# subdomains are schools (acme.localhost -> school with slug "acme").
TENANCY_CENTRAL_DOMAINS=localhost,127.0.0.1
TENANCY_BASE_DOMAIN=localhost

# Railway / no wildcard subdomains: set to "true" to enable /t/{slug} temporary
# tenant entry on the central domain (e.g. https://app.up.railway.app/t/acme).
TENANCY_ALLOW_PATH_ENTRY=false

# ---------------------------------------------------------------------------
# Production / Railway deployment
# ---------------------------------------------------------------------------

# The bare domain is the platform super-admin area; schools live on subdomains.
# Example: APP_DOMAIN=somaplus.example.com -> super admin at somaplus.example.com,
# school at acme.somaplus.example.com
APP_DOMAIN=localhost

# Set these before first deploy, then run php artisan db:seed --force once
# to create the super admin and a demo school.
SUPER_ADMIN_EMAIL=admin@somaplus.test
SUPER_ADMIN_PASSWORD=

DEMO_OWNER_EMAIL=owner@acme.test
DEMO_OWNER_PASSWORD=

# Railway: log to stderr so logs show in the Railway dashboard
LOG_CHANNEL=stderr

# Run queue worker + scheduler inside the web container. Set to 0 if you run
# them as separate Railway services.
RUN_WORKERS=1

# Production (Railway): APP_ENV=production and APP_URL=https://<your-domain>. Links are forced to https
# and the proxy's X-Forwarded-Proto is trusted, so styles and scripts load on the https page.

# Where a school's own custom domain must point (CNAME). On Railway, set this
# to the service hostname, e.g. xxxx.up.railway.app. Defaults to APP_DOMAIN.
CUSTOM_DOMAIN_TARGET=
