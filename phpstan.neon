includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - app
        - config
        - database
        - lang
        - routes
    ignoreErrors:
        # This trait is only used by the tests for now (tests are not analysed).
        # The first job that uses it makes PHPStan report this ignore as unmatched;
        # delete the entry in that PR.
        -
            message: '#^Trait App\\Tenancy\\TenantAwareJob is used zero times and is not analysed\.$#'
            path: app/Tenancy/TenantAwareJob.php
