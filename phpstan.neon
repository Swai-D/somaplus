includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - app
        - config
        - database
        - lang
        - routes
    ignoreErrors:
        # These two traits are only used by the tests for now (tests are not analysed).
        # The first model and the first job that use them make PHPStan report this
        # ignore as unmatched; delete the matching entry in that PR.
        -
            message: '#^Trait App\\Models\\Concerns\\BelongsToTenant is used zero times and is not analysed\.$#'
            path: app/Models/Concerns/BelongsToTenant.php
        -
            message: '#^Trait App\\Tenancy\\TenantAwareJob is used zero times and is not analysed\.$#'
            path: app/Tenancy/TenantAwareJob.php
